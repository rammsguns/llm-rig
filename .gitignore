# Generated by the scripts, machine-specific, overwritten on every run.
# Regenerate with 40-serve.sh / 50-claude-code.sh rather than committing these:
# they embed absolute paths, this host's VRAM split, and its LAN address.
etc/llama-swap.yaml
claude-code-local.env

# Operator-declared compute pool: which GPUs may serve inference, by UUID.
# Machine-local configuration -- it names this host's silicon and must never
# be committed. Format and rationale: README "The compute pool".
etc/inference-gpus

# What llm-rig installed on THIS machine: version, digest, timestamp. Machine
# state, not configuration -- the deliberate pin lives in lib/swap.sh.
etc/llama-swap.installed

# The commit this machine last built. Machine state, not configuration -- the
# deliberate pin is llamacpp.ref, which IS meant to be committed.
.llamacpp-rev

# Runtime output.
logs/
*.log

# Out-of-tree llama.cpp build output (20-build-llamacpp.sh).
build/
