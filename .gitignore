# Generated by the scripts, machine-specific, overwritten on every run.
# Regenerate with 40-serve.sh / 50-claude-code.sh rather than committing these:
# they embed absolute paths, this host's VRAM split, and its LAN address.
etc/llama-swap.yaml
claude-code-local.env

# The commit this machine last built. Machine state, not configuration -- the
# deliberate pin is llamacpp.ref, which IS meant to be committed.
.llamacpp-rev

# Runtime output.
logs/
*.log

# Out-of-tree llama.cpp build output (20-build-llamacpp.sh).
build/
